# The gateway URL and API key
GROCERY_GATEWAY_BASE_URL=
GROCERY_GATEWAY_API_KEY=

# The model served by the gateway
GROCERY_MODEL=

# Telegram bot (optional: only needed for `grocery telegram`)
# Token from @BotFather; allowlist is a comma-separated list of numeric
# Telegram user IDs permitted to chat with the bot. If the allowlist is
# unset or empty, nobody can use the bot (fail closed).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Web dashboard/admin (only needed for `grocery webapp`)
# Password protecting the dashboard login. Fail-closed: unset or empty
# means nobody can log in. The session secret signs login cookies; if
# unset, one is generated and persisted to the admin store.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
